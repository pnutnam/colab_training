# ============================================================================
# colab_training environment
# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Loaded by scripts/env.sh, the Makefile, and (optionally) your shell profile.
# ============================================================================

# --- Hugging Face -----------------------------------------------------------
# Token from https://huggingface.co/settings/tokens — needs `write` scope so
# the Colab VM can push trained adapters/datasets back to the Hub.
HF_TOKEN=
# Your HF username (used to build output repo ids like <user>/<run-name>).
HF_USERNAME=
# Silence the `hf` CLI update nag in scripts/CI.
HF_HUB_DISABLE_UPDATE_CHECK=1
# Bump for slow links (default 10s causes CDN read timeouts).
HF_HUB_DOWNLOAD_TIMEOUT=30

# --- Google Colab (google-colab-cli) ----------------------------------------
# adc  = Application Default Credentials via gcloud (recommended for agents;
#        one-time `make auth-colab`). Requires the 4-scope gcloud login.
# oauth2 = CLI's own browser consent flow (paste-back code, human-only).
COLAB_AUTH=adc
# Multi-account rotation: uncomment and set to a registered account label
# (see `make account-list` / scripts/accounts.sh) to run ALL colab commands
# as that account. Unset = the default ADC slot (~/.config/gcloud).
# COLAB_ACCOUNT=pro
# Default accelerator for `make train` / launch_training.sh.
# One of: T4, L4, G4, H100, A100 (availability depends on your Colab tier).
COLAB_DEFAULT_GPU=T4
# Execution timeout (seconds) for colab run. Default 4h; must exceed your
# longest silent stretch (dep installs, model downloads, long steps).
COLAB_RUN_TIMEOUT=14400

# --- Training defaults (env-fallbacks for training/train_sft.py) ------------
BASE_MODEL=Qwen/Qwen3-1.7B
# Dataset repo, e.g. yourname/my-sft-data (HF dataset with `text` or
# `messages` columns) — see training/README section in the root README.
DATASET_REPO=
# Output model repo, e.g. yourname/qwen3-1.7b-qlora-mytask. Created on push.
OUTPUT_REPO=
EPOCHS=1
LEARNING_RATE=2e-4
MAX_LENGTH=2048
PER_DEVICE_BATCH=2
GRAD_ACCUM=8

# --- Optional integrations ---------------------------------------------------
# WANDB_API_KEY=
# WANDB_PROJECT=colab-training
